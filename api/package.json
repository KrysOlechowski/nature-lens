{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "db:migrate": "node-pg-migrate up --envPath .env --migrations-dir migrations",
    "db:migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language ts --migration-filename-format utc",
    "db:migrate:down": "node-pg-migrate down --envPath .env --migrations-dir migrations",
    "start": "node --enable-source-maps dist/main.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.migrations.json && tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "dotenv": "^18.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "testcontainers": "^12.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
