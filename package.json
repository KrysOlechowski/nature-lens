{
  "name": "nature-lens",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "pnpm --filter web --filter api build",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:migrate:create": "pnpm --filter api db:migrate:create",
    "db:migrate:down": "pnpm --filter api db:migrate:down",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint web api",
    "test": "pnpm --filter api test",
    "test:integration": "pnpm --filter api test:integration",
    "typecheck": "pnpm --filter web --filter api typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.0"
  }
}
